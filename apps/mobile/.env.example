# Optional. Base URL of the API, without /api. Defaults: http://localhost:3000 on the iOS
# simulator, http://10.0.2.2:3000 on the Android emulator. On a real phone, use the Mac's LAN
# address, e.g. http://192.168.1.20:3000 (phone and Mac on the same network).
# Required for release builds, and must be https://: the app refuses to start otherwise.
EXPO_PUBLIC_API_URL=
