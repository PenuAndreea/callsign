# Copy to `.env` (git-ignored). Validated at startup by src/config/env.schema.ts.

# development | test | production
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/callsign

# Web app origin, for CORS with credentials (Vite dev server)
WEB_ORIGIN=http://localhost:5173

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Secure cookies are on by default. Off for http://localhost only (Safari drops secure cookies there).
COOKIE_SECURE=false
